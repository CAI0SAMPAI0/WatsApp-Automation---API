generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  waSessions        WaSession[]
  scheduledMessages ScheduledMessage[]

  @@map("users")
}

model WaSession {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  sessionKey        String             @unique
  authStateJson     String // Store as JSON string, consider encryption for production
  isConnected       Boolean            @default(false)
  lastSeenAt        DateTime?
  scheduledMessages ScheduledMessage[]

  @@map("wa_sessions")
}

enum MessageMode {
  text
  file
  file_text
}

enum MessageStatus {
  pending
  running
  sent
  failed
}

model ScheduledMessage {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  sessionId     String
  waSession     WaSession     @relation(fields: [sessionId], references: [id])
  targetJid     String
  mode          MessageMode
  message       String?
  fileUrl       String?
  fileName      String?
  scheduledAtTz DateTime
  timezone      String        @default("America/Sao_Paulo")
  status        MessageStatus @default(pending)
  batchId       String?
  errorMessage  String?
  createdAt     DateTime      @default(now())
  sentAt        DateTime?

  @@map("scheduled_messages")
}
